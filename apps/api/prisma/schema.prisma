generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
}

enum UserRole {
  ADMIN
  BILLING_USER
  ACCOUNTANT
}

enum CustomerType {
  PERSON
  ORGANIZATION
}

enum CustomerAddressType {
  BUSINESS
  BILLING
  SHIPPING
  OTHER
}

enum CustomerAddressPurpose {
  BUSINESS
  BILLING
  SHIPPING
  OTHER
}

model Tenant {
  id           String   @id @default(cuid())
  name         String   @unique
  subdomain    String?  @unique
  customDomain String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings                          TenantSettings?
  memberships                       TenantMembership[]
  customers                         Customer[]
  customerAddresses                 CustomerAddress[]
  customerEmails                    CustomerEmail[]
  customerPhones                    CustomerPhone[]
  customerAddressPurposeAssignments CustomerAddressPurposeAssignment[]
}

model TenantSettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  legalName           String?
  legalId             String?
  businessAddress     String?
  contactEmail        String?
  contactPhone        String?
  contactWhatsApp     String?
  websiteUrl          String?
  logoUrl             String?
  emailLogoUrl        String?
  primaryColor        String?
  secondaryColor      String?
  countryCode         String?  @db.VarChar(2)
  defaultCurrencyCode String?  @db.VarChar(3)
  timezone            String?  @db.VarChar(100)
  locale              String?  @db.VarChar(20)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  fullName           String
  passwordHash       String
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(false)
  activeJti          String?
  activeAt           DateTime?
  platformRole       PlatformRole?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  memberships         TenantMembership[]
  passwordResetTokens PasswordResetToken[]
}

model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, role])
  @@map("tenant_memberships")
}

model Customer {
  id                            String       @id @default(cuid())
  tenantId                      String
  type                          CustomerType
  displayName                   String
  firstName                     String?
  middleName                    String?
  lastName                      String?
  secondLastName                String?
  legalName                     String?
  tradeName                     String?
  identificationType            String
  identificationValue           String
  normalizedIdentificationValue String
  countryCode                   String?      @db.VarChar(2)
  email                         String?
  billingEmail                  String?
  phone                         String?
  isActive                      Boolean      @default(true)
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt

  tenant                    Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses                 CustomerAddress[]
  emails                    CustomerEmail[]
  phones                    CustomerPhone[]
  addressPurposeAssignments CustomerAddressPurposeAssignment[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, displayName])
  @@map("customers")
}

model CustomerAddress {
  id           String              @id @default(cuid())
  tenantId     String
  customerId   String
  type         CustomerAddressType
  countryCode  String?             @db.VarChar(2)
  region       String?
  city         String?
  district     String?
  postalCode   String?
  addressLine1 String?
  addressLine2 String?
  isPrimary    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant             Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer                           @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  purposeAssignments CustomerAddressPurposeAssignment[]

  @@unique([id, customerId, tenantId])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, customerId, type])
  @@map("customer_addresses")
}

model CustomerEmail {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  label      String?
  email      String
  isPrimary  Boolean  @default(false)
  isBilling  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("customer_emails")
}

model CustomerPhone {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  label      String?
  phone      String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("customer_phones")
}

model CustomerAddressPurposeAssignment {
  tenantId            String
  customerId          String
  customerAddressId   String
  purpose             CustomerAddressPurpose
  isPrimaryForPurpose Boolean                @default(false)
  createdAt           DateTime               @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customerAddress CustomerAddress @relation(fields: [customerAddressId, customerId, tenantId], references: [id, customerId, tenantId], onDelete: Cascade)

  @@id([customerAddressId, purpose])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, customerAddressId])
  @@index([tenantId, customerId, purpose])
  @@map("customer_address_purpose_assignments")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
